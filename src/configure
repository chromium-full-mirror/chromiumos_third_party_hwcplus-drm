cat > config <<EOF
PKG_CONFIG = $PKG_CONFIG
LIBDIR = $LIBDIR
CC = $CC
CXX = $CXX
EOF

sed -e "s/@LIBDIR@/$LIBDIR/" hwcplus-drm.pc.in > hwcplus-drm.pc
